# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Compose reads .env for ${VAR} interpolation.

# Required: signing key for session tokens, at least 32 bytes.
JWT_SECRET=

# Required: Postgres credentials used by the db service and the app.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Optional: host port for the app (container port is always 8080).
APP_PORT=8080

# Optional: set to true when serving over HTTPS.
COOKIE_SECURE=
